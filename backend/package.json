{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "description": "Backend for Task Manager App",
  "main": "dist/server.js",
  "scripts": {
    "test": "mocha",
    "test:report": "mocha --reporter ./test/reporters/markdown-table-reporter.cjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "dev:test": "tsx watch server.ts --test",
    "prod": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@clerk/express": "^2.0.8",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^5.2.1",
    "mongoose": "^8.0.0",
    "multer": "^2.1.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/sinon": "^21.0.1",
    "@types/supertest": "^7.2.0",
    "chai": "^4.5.0",
    "esm": "^3.2.25",
    "mocha": "^11.0.1",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.0",
    "sinon": "^19.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "author": "Task Manager Team",
  "license": "ISC"
}
